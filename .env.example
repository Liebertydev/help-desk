# Copie este arquivo para ".env" e ajuste os valores para a sua máquina.
# O .env NÃO vai para o git (está no .gitignore). Só preencha o que for
# diferente do padrão; linhas ausentes usam o valor padrão indicado.

# Porta da API (padrão: 8080)
SERVER_PORT=8080

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/helpdesk
DB_USERNAME=postgres
DB_PASSWORD=

# Endereços do front autorizados (padrão: http://localhost:5173,http://localhost:3000)
# CORS_ORIGENS=http://localhost:5173

# Validade de cada sessão após o login (padrão: 8 horas). PT30M significa 30 minutos.
# SESSAO_DURACAO=PT8H

# Intervalo de limpeza dos tokens expirados, em milissegundos (padrão: 1 minuto).
# SESSAO_INTERVALO_LIMPEZA_MS=60000
